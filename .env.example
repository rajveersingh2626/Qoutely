# ==============================================================================
# QUOTELY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Google Gemini API (Model: Gemini 2.5 Flash for RAG proposal ingestion)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Supabase Multi-Tenant PostgreSQL & Auth
# Get credentials from: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Node Environment
NODE_ENV=development
